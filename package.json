{
  "name": "master11408",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.12.0 <27"
  },
  "scripts": {
    "setup:local": "node --experimental-strip-types scripts/init-local.ts",
    "admin": "node --experimental-strip-types scripts/admin.ts",
    "auth:generate": "auth generate --config scripts/auth-schema.config.ts --output server/db/auth-schema.ts --yes",
    "dev": "XDG_CONFIG_HOME=.wrangler WRANGLER_LOG_PATH=.wrangler/logs vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "types:generate": "wrangler types worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:reset:local": "node --experimental-strip-types scripts/reset-local.ts",
    "db:generate": "drizzle-kit generate",
    "content:validate": "node --experimental-strip-types scripts/content-validator.ts",
    "content:sync:local": "node --experimental-strip-types scripts/content-sync.ts --env local",
    "content:sync:remote": "node --experimental-strip-types scripts/content-sync.ts --remote --dry-run",
    "content:sync:remote:apply": "node --experimental-strip-types scripts/content-sync.ts --remote",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:all": "pnpm db:migrate:remote && pnpm content:sync:remote:apply && pnpm build && wrangler deploy",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm content:validate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.12",
    "@better-auth/passkey": "1.7.12",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "katex": "0.19.1",
    "pinia": "4.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "vue": "3.5.42",
    "vue-router": "5.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261024.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/katex": "0.16.8",
    "@types/node": "24.13.4",
    "@vitejs/plugin-vue": "6.0.8",
    "auth": "1.7.12",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "gray-matter": "4.0.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.2.2",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11",
    "wrangler": "4.152.0",
    "yaml": "2.9.1"
  }
}
